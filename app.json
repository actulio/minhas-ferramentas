{
  "expo": {
    "name": "Minhas Ferramentas",
    "slug": "minhas-ferramentas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minhas-ferramentas",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Este app usa os sensores de movimento para a bússola e o nível."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.actulio.minhasferramentas"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Este app usa sua localização para marcar pontos e apontar de volta para eles."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "170a5e8b-2abe-4865-9bbb-15900301409d"
      }
    }
  }
}
